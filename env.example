# Set these in the provider PANEL's environment-variable UI.
# Never commit real values into these files.

# xray UUID for the VMess-WS inbound
UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Cloudflare tunnel hostname routed to this deployment
AGN=cf-tunnel-roamingX.kingslanding.eu.org

# Cloudflare tunnel token for AGN's tunnel.
# Get it from the Cloudflare dashboard (Tunnels -> your tunnel -> Add a replica,
# the string after --token) or via the Cloudflare API.
# A genuine token is ~184-240 characters. After pasting it anywhere, VERIFY:
#   the length must be in that range and, if you can, compare a sha256 of both copies.
# A token that gained/lost characters in copy-paste fails SILENTLY:
# cloudflared exits instantly with "Provided Tunnel token is not valid".
AGK=eyJ...

# Optional: xray VMess-WS port inside the container (default 8001)
VMPT=8001

# --- Memory trims for ~128 MB containers (Galaxy Nano) ---
# Node: cap the supervisor's heap so it can never balloon.
# (--optimize-for-size is NOT allowed in NODE_OPTIONS — Node refuses
# to start; --max-old-space-size is allowed. Smoke-test finding.)
NODE_OPTIONS=--max-old-space-size=32
# cloudflared is a Go binary: cap its heap soft limit so the GC works
# harder instead of growing into the container ceiling.
GOMEMLIMIT=48MiB
# glibc: fewer malloc arenas, less RSS slack across all processes.
MALLOC_ARENA_MAX=2

# PORT is assigned by the platform (Galaxy sets it); index.js serves
# the placeholder "ok" on it in-process. Do not set it manually.
